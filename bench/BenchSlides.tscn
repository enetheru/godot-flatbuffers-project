[gd_scene format=3]

[ext_resource type="Script" path="res://bench/bench_slides.gd" id="1_script"]

[node name="BenchSlides" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Toolbar" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Back" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "Bench list"

[node name="Prev" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "Previous"

[node name="Next" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "Next"

[node name="Index" type="Label" parent="Margin/VBox/Toolbar"]
custom_minimum_size = Vector2(72, 0)
layout_mode = 2
text = "1 / 5"
vertical_alignment = 1

[node name="Target" type="OptionButton" parent="Margin/VBox/Toolbar"]
custom_minimum_size = Vector2(180, 0)
layout_mode = 2

[node name="Rerun" type="Button" parent="Margin/VBox/Toolbar"]
layout_mode = 2
text = "Re-run"

[node name="Lamp" type="ColorRect" parent="Margin/VBox/Toolbar"]
custom_minimum_size = Vector2(14, 14)
layout_mode = 2
size_flags_horizontal = 4
size_flags_vertical = 4
mouse_filter = 2
color = Color(0.35, 0.35, 0.38, 1)

[node name="Busy" type="Label" parent="Margin/VBox/Toolbar"]
layout_mode = 2
size_flags_horizontal = 3
text = "Idle"
vertical_alignment = 1

[node name="BusyBar" type="ProgressBar" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 10)
layout_mode = 2
max_value = 3.0
show_percentage = false

[node name="Scroll" type="ScrollContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="Body" type="VBoxContainer" parent="Margin/VBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Margin/VBox/Scroll/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.93, 0.93, 0.96, 1)
theme_override_font_sizes/font_size = 32
text = "Store"

[node name="Codecs" type="Label" parent="Margin/VBox/Scroll/Body"]
layout_mode = 2
autowrap_mode = 3
text = "Dictionary is a tree of dictionaries, saved with var_to_bytes and loaded with bytes_to_var. Objects is Foo, Bar, FooBar, and FooBarContainer, saved with var_to_bytes_with_objects and loaded with bytes_to_var_with_objects. Both start from the same field values."

[node name="TimesHead" type="Label" parent="Margin/VBox/Scroll/Body"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.78, 0.86, 1)
theme_override_font_sizes/font_size = 18
text = "What the timer includes"

[node name="Times" type="Label" parent="Margin/VBox/Scroll/Body"]
layout_mode = 2
autowrap_mode = 3
text = " "

[node name="ShowsHead" type="Label" parent="Margin/VBox/Scroll/Body"]
