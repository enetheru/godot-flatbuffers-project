## Reading Orc FlatBuffers

# Now that we have successfully created an Orc FlatBuffer, the monster data can
# be saved, sent over a network, etc. Let's now adventure into the inverse, and
# access a FlatBuffer.

# This section requires the same import/include, namespace, etc. requirements
# as before:
# #include "monster_generated.h" // This was generated by `flatc`.

const schema = preload("res://tests/fb_monster/Monster_generated.gd")

# using namespace MyGame::Sample; // Specified in the schema.

# Then, assuming you have a buffer of bytes received from disk, network, etc.,
# you can start accessing the buffer like so:

func read_orc_flatbuffer( bytes:PackedByteArray ) -> void:
	if not test.TEST_FALSE_RET(bytes.is_empty(),
		"bytes should not be empty"): return

	var monster := schema.Monster.new()
	monster.assign_buffer(bytes, bytes.decode_u32(0))

	verifier.set_buffer(bytes)
	if not test.TEST_TRUE_RET(monster.verify(verifier),
		"verification should pass"): return

	# Again, make sure you read the bytes in BINARY mode, otherwise the code
	# below won't work.
	# uint8_t *buffer_pointer = /* the data you just read */;

	# Get a pointer to the root object inside the buffer.
	# auto monster = GetMonster(buffer_pointer);
	#var monster:schema.Monster = schema.get_Monster( bytes )
	if not test.TEST_TRUE_RET(is_instance_valid(monster),
		"monster should be a valid instance"): return

	# `monster` is of type `Monster *`.
	# NOTE: in gdscript monster is a schema.Monster which is a specialisation
	# of FlatBuffer generated by the flatc compiler. Internally it has a
	# PackedByteArray, and an index to the start of the object. Multiple
	# FlatBuffer objects can share the same PackedByteArray, pointing at
	# the section where their data is stored.

	# Note: root object pointers are NOT the same as `buffer_pointer`.
	# `GetMonster` is a convenience function that calls `GetRoot<Monster>`, the
	# latter is also available for non-root types.

	# NOTE: GetRoot is not implemented
	# But if I was to, it might look something like:
	# static func get_root( script:GDScript, bytes:PackedByteArray ) -> Object

	# If you look in the generated files from the schema compiler, you will see
	# it generated accessors for all non-deprecated fields. For example:
	# auto hp = monster->hp();
	var hp:int = monster.hp()
	# auto mana = monster->mana();
	var mana:int = monster.mana()
	# auto name = monster->name()->c_str();
	var name:String = monster.name()

	# These should hold 300, 150, and "Orc" respectively.
	test.TEST_EQ( 300, hp,  "monster.hp()" )
	test.TEST_EQ( 150, mana,  "monster.mana()" )
	test.TEST_EQ( "Orc", name , "monster.name()" )
	# create_Monster passes mana 150, which is the schema default, so the field
	# is left out of the buffer and the accessor still returns 150.
	test.TEST_FALSE(monster.mana_is_present(), "default mana is not stored")
	test.TEST_TRUE(monster.hp_is_present(), "non-default hp is stored")
	test.TEST_EQ(schema.Color_.RED, monster.color(), "monster.color()")
	test.TEST_TRUE(monster.color_is_present(), "non-default color is stored")

	# To access sub-objects, in the case of our pos, which is a Vec3:
	# auto pos = monster->pos();
	var pos:Vector3 = monster.pos()
	# auto x = pos->x();
	var x:float = pos.x
	# auto y = pos->y();
	var y:float = pos.y
	# auto z = pos->z();
	var z:float = pos.z

	# x, y, and z will contain 1.0, 2.0, and 3.0, respectively.
	test.TEST_EQ( x, 1.0, "monster.pos.x()" )
	test.TEST_EQ( y, 2.0, "monster.pos.y()" )
	test.TEST_EQ( z, 3.0, "monster.pos.z()" )

	# Note: Had we not set pos during serialization, it would be a null-value.

	# Similarly, we can access elements of the inventory vector by indexing it.
	# You can also iterate over the length of the array/vector representing the
	# FlatBuffers vector.
	# auto inv = monster->inventory(); // A pointer to a `flatbuffers::Vector<>`.
	var inv:PackedByteArray = monster.inventory()
	# auto inv_len = inv->size();
	var inv_len:int = inv.size() # 10
	# auto third_item = inv->Get(2);
	@warning_ignore("untyped_declaration")
	var third_item = inv[2]

	# NOTE: monster.inventory() can, depending on type, decode and returns the
	# the whole array. I have provided *_size(), and *_at(idx) to help.
	test.TEST_EQ(10, inv_len, "monster.inventory().size()")
	test.TEST_EQ(2, third_item, "monster.inventory().size()")
	test.TEST_EQ(10, monster.inventory_size(), "monster.inventory_size()")
	test.TEST_EQ(2, monster.inventory_at(2), "monster.inventory_at(2)")

	# For vectors of tables, you can access the elements like any other vector,
	# except you need to handle the result as a FlatBuffer table:
	# auto weapons = monster->weapons(); // A pointer to a `flatbuffers::Vector<>`.
	var weapons:Array = monster.weapons()
	# auto weapon_len = weapons->size();
	var weapon_len:int = weapons.size()
	test.TEST_EQ(2, weapon_len, "weapons.size()")
	var weapon_len_:int = monster.weapons_size()
	test.TEST_EQ(2, weapon_len_, "monster.weapons_size()")

	# NOTE: [] operator does not return a typed object.
	# whereas the weapons_at(int) function can return a typed object
	var second_weapon:schema.Weapon = weapons[1]

	# auto second_weapon_name = weapons->Get(1)->name()->str();
	var second_weapon_name:String = second_weapon.name()
	test.TEST_EQ("Axe", second_weapon_name,  "second_weapon.name()")
	test.TEST_EQ("Axe", monster.weapons_at(1).name(),
			"monster.weapons_at(1).name()")

	# auto second_weapon_damage = weapons->Get(1)->damage()
	var second_weapon_damage:int = second_weapon.damage()
	test.TEST_EQ(5, second_weapon_damage, "second_weapon.damage()")
	test.TEST_EQ(5, monster.weapons_at(1).damage(),
			"monster.weapons_at(1).damage()")
	var weapon := schema.Weapon.new()
	var sword:schema.Weapon = monster.weapons_at(0, weapon)
	test.TEST_TRUE(sword == weapon, "weapons_at returns the passed view")
	test.TEST_EQ("Sword", weapon.name(), "reused weapon 0")
	test.TEST_EQ(3, weapon.damage(), "reused weapon 0 damage")
	monster.weapons_at(1, weapon)
	test.TEST_EQ("Axe", sword.name(), "reused weapon follows the later index")
	test.TEST_EQ(5, sword.damage(), "reused weapon damage follows the later index")

	# Last, we can access our Equipped FlatBuffer union. Just like when we
	# created the union, we need to get both parts of the union: the type and
	# the data.

	# We can access the type to dynamically cast the data as needed (since the
	# union only stores a FlatBuffer table).
	# auto union_type = monster.equipped_type();
	var union_type:schema.Equipment = monster.equipped_type()
	test.TEST_EQ( schema.Equipment.WEAPON, union_type, "monster.equipped_type()" )

	# if (union_type == Equipment_Weapon) {
	#   auto weapon = static_cast<const Weapon*>(monster->equipped()); // Requires `static_cast`
	#                                                                  // to type `const Weapon*`.
	#   auto weapon_name = weapon->name()->str(); // "Axe"
	#   auto weapon_damage = weapon->damage();    // 5
	# }
	match union_type:
		schema.Equipment.WEAPON:
			var weapon:schema.Weapon = monster.equipped()
			var weapon_name:String = weapon.name()
			var weapon_damage:int = weapon.damage()
			test.TEST_EQ( weapon_name, "Axe", "weapon.name()" )
			test.TEST_EQ( weapon_damage, 5, "weapon.damage()" )

	test.TEST_TRUE(monster.path_is_present(), "path stored")
	test.TEST_EQ(2, monster.path_size(), "path size")
	test.TEST_EQ(Vector3(1, 2, 3), monster.path_at(0), "path 0")
	test.TEST_EQ(Vector3(4, 5, 6), monster.path_at(1), "path 1")
	var points:PackedVector3Array = monster.path()
	test.TEST_EQ(2, points.size(), "path() size")
	test.TEST_EQ(Vector3(1, 2, 3), points[0], "path() 0")
	test.TEST_EQ(Vector3(4, 5, 6), points[1], "path() 1")
	test.TEST_FALSE(monster.has_method(&"friendly"), "deprecated friendly is omitted")


## A monster with no fields stored still reads the schema defaults.
func read_omitted_defaults() -> void:
	var fbb := FlatBufferBuilder.new()
	var builder := schema.MonsterBuilder.new(fbb)
	fbb.finish(builder.finish())
	var bytes:PackedByteArray = fbb.get_buffer()
	var monster := schema.Monster.new()
	monster.assign_buffer(bytes, bytes.decode_u32(0))
	if not test.TEST_TRUE_RET(monster.verify(verifier), "omitted monster verifies"):
		return
	test.TEST_FALSE(monster.mana_is_present(), "omitted mana")
	test.TEST_EQ(150, monster.mana(), "omitted mana reads 150")
	test.TEST_FALSE(monster.hp_is_present(), "omitted hp")
	test.TEST_EQ(100, monster.hp(), "omitted hp reads 100")
	test.TEST_FALSE(monster.color_is_present(), "omitted color")
	test.TEST_EQ(schema.Color_.BLUE, monster.color(), "omitted color reads Blue")
	test.TEST_FALSE(monster.name_is_present(), "omitted name")
	test.TEST_EQ("", monster.name(), "omitted name reads empty")
	test.TEST_FALSE(monster.inventory_is_present(), "omitted inventory")
	test.TEST_EQ(0, monster.inventory_size(), "omitted inventory size")
	test.TEST_EQ(0, monster.inventory().size(), "omitted inventory array")
	test.TEST_FALSE(monster.weapons_is_present(), "omitted weapons")
	test.TEST_EQ(0, monster.weapons_size(), "omitted weapons size")
	test.TEST_FALSE(monster.equipped_is_present(), "omitted equipped")
	test.TEST_EQ(null, monster.equipped(), "omitted equipped value")
	test.TEST_EQ(schema.Equipment.NONE, monster.equipped_type(), "omitted equipped type")
	test.TEST_FALSE(monster.pos_is_present(), "omitted pos")
	test.TEST_FALSE(monster.path_is_present(), "omitted path")
	test.TEST_EQ(0, monster.path_size(), "omitted path size")
	test.TEST_TRUE(schema.equipment_verify(verifier, null, schema.Equipment.NONE), "omitted union verifies")
	test.TEST_FALSE(schema.equipment_verify(verifier, null, 9), "unknown equipment type fails")


## A stored discriminant of 0 is present, and it still has no union value.
func read_written_none() -> void:
	var fbb := FlatBufferBuilder.new()
	var builder := schema.MonsterBuilder.new(fbb)
	builder.add_equipped_type(schema.Equipment.NONE)
	fbb.finish(builder.finish())
	var bytes:PackedByteArray = fbb.get_buffer()
	var monster := schema.Monster.new()
	monster.assign_buffer(bytes, bytes.decode_u32(0))
	if not test.TEST_TRUE_RET(monster.verify(verifier), "written none verifies"):
		return
	test.TEST_TRUE(monster.get_field_offset(schema.Monster.VT_EQUIPPED_TYPE) != 0, "written none type is stored")
	test.TEST_EQ(schema.Equipment.NONE, monster.equipped_type(), "written none type")
	test.TEST_FALSE(monster.equipped_is_present(), "none has no value")
	test.TEST_EQ(null, monster.equipped(), "none value")


## Each case copies the good orc and breaks one slot. verify() must return false.
## Field reads stay on the intact buffer above.
func reject_broken_buffers( bytes:PackedByteArray ) -> void:
	var intact:PackedByteArray = bytes.duplicate()
	var monster:schema.Monster = _monster_at_root( intact )
	if not test.TEST_TRUE_RET( monster.verify( verifier ), "intact buffer verifies" ):
		return

	_expect_reject( PackedByteArray(), "empty buffer" )
	_expect_truncated( bytes )
	_expect_vtable( bytes )
	_expect_name_offset( bytes )
	_expect_name_string( bytes )
	_expect_inventory_length( bytes )
	_expect_weapon_element( bytes )
	_expect_equipped_offset( bytes )


func _monster_at_root( bytes:PackedByteArray ) -> schema.Monster:
	var monster:schema.Monster = schema.Monster.new()
	var root:int = 0
	if bytes.size() >= 4:
		root = bytes.decode_u32( 0 )
		if root < 0 or root >= bytes.size():
			root = 0
	monster.assign_buffer( bytes, root )
	return monster


func _expect_reject( bytes:PackedByteArray, label:String ) -> void:
	var monster:schema.Monster = _monster_at_root( bytes )
	test.TEST_FALSE( monster.verify( verifier ), label )


func _expect_truncated( bytes:PackedByteArray ) -> void:
	# Root is near the front. Dropping the tail leaves the table pointer in range
	# and cuts off the bytes the later field checks follow.
	var root:int = bytes.decode_u32( 0 )
	var sliced:PackedByteArray = bytes.slice( 0, root + 4 )
	var monster:schema.Monster = schema.Monster.new()
	monster.assign_buffer( sliced, root )
	test.TEST_FALSE( monster.verify( verifier ), "truncated buffer" )


func _expect_vtable( bytes:PackedByteArray ) -> void:
	var bad:PackedByteArray = bytes.duplicate()
	var root:int = bad.decode_u32( 0 )
	bad.encode_s32( root, 0x7FFFFFFF )
	var monster:schema.Monster = schema.Monster.new()
	monster.assign_buffer( bad, root )
	verifier.set_buffer( bad )
	test.TEST_FALSE( monster.verify_table_start( verifier ), "verify_table_start rejects a vtable outside the buffer" )
	test.TEST_FALSE( monster.verify( verifier ), "vtable outside the buffer" )


func _expect_name_offset( bytes:PackedByteArray ) -> void:
	var bad:PackedByteArray = bytes.duplicate()
	var probe:schema.Monster = _monster_at_root( bad )
	var slot:int = probe.get_start() + probe.get_field_offset( schema.Monster.VT_NAME )
	bad.encode_u32( slot, 0xFFFFFFF0 )

	var monster:schema.Monster = _monster_at_root( bad )
	test.TEST_FALSE( monster.verify( verifier ), "name offset past the buffer" )
	test.TEST_FALSE( monster.verify_offset( verifier, schema.Monster.VT_NAME ), "verify_offset rejects the name" )


func _expect_name_string( bytes:PackedByteArray ) -> void:
	var bad:PackedByteArray = bytes.duplicate()
	var probe:schema.Monster = _monster_at_root( bad )
	var string_at:int = probe.get_offset_field_start( schema.Monster.VT_NAME )
	bad.encode_u32( string_at, bad.size() )

	var monster:schema.Monster = _monster_at_root( bad )
	test.TEST_FALSE( monster.verify( verifier ), "name string length past the buffer" )
	test.TEST_TRUE( monster.verify_offset( verifier, schema.Monster.VT_NAME ), "name offset still in range" )
	test.TEST_FALSE( monster.verify_string( verifier, schema.Monster.VT_NAME ), "verify_string rejects the name" )


func _expect_inventory_length( bytes:PackedByteArray ) -> void:
	var bad:PackedByteArray = bytes.duplicate()
	var probe:schema.Monster = _monster_at_root( bad )
	var vector_at:int = probe.get_offset_field_start( schema.Monster.VT_INVENTORY )
	bad.encode_u32( vector_at, bad.size() )

	var monster:schema.Monster = _monster_at_root( bad )
	test.TEST_FALSE( monster.verify( verifier ), "inventory length past the buffer" )
	test.TEST_TRUE( monster.verify_offset( verifier, schema.Monster.VT_INVENTORY ), "inventory offset still in range" )
	test.TEST_FALSE( monster.verify_vector_u8( verifier, schema.Monster.VT_INVENTORY ), "verify_vector_u8 rejects inventory" )


func _expect_weapon_element( bytes:PackedByteArray ) -> void:
	var bad:PackedByteArray = bytes.duplicate()
	var probe:schema.Monster = _monster_at_root( bad )
	var element_pos:int = probe.get_offset_field_start( schema.Monster.VT_WEAPONS ) + 4
	# One byte past the offset slot, still inside the buffer, not a weapon table.
	bad.encode_u32( element_pos, 1 )

	var monster:schema.Monster = _monster_at_root( bad )
	test.TEST_FALSE( monster.verify( verifier ), "weapon element is not a table" )


func _expect_equipped_offset( bytes:PackedByteArray ) -> void:
	var bad:PackedByteArray = bytes.duplicate()
	var probe:schema.Monster = _monster_at_root( bad )
	var slot:int = probe.get_start() + probe.get_field_offset( schema.Monster.VT_EQUIPPED )
	bad.encode_u32( slot, 1 )

	var monster:schema.Monster = _monster_at_root( bad )
	test.TEST_FALSE( monster.verify( verifier ), "equipped target is not a weapon table" )
	test.TEST_TRUE( monster.verify_offset( verifier, schema.Monster.VT_EQUIPPED ), "equipped offset still inside the buffer" )
